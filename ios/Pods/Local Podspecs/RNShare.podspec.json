{
  "name": "RNShare",
  "version": "11.1.0",
  "summary": "Social share, sending simple data to other apps.",
  "homepage": "https://react-native-share.github.io/react-native-share/",
  "license": "MIT",
  "authors": {
    "Esteban Fuentealba": "efuentealba@json.cl"
  },
  "platforms": {
    "ios": "8.0"
  },
  "source": {
    "git": "https://github.com/react-native-community/react-native-share.git",
    "tag": "v11.1.0"
  },
  "source_files": "ios/**/*.{h,m,mm}",
  "ios": {
    "weak_frameworks": "LinkPresentation"
  },
  "compiler_flags": "$(inherited) -DFOLLY_NO_CONFIG -DFOLLY_MOBILE=1 -DFOLLY_USE_LIBCPP=1 -DFOLLY_CFG_NO_COROUTINES=1 -Wno-comma -Wno-shorten-64-to-32",
  "dependencies": {
    "React-Core": [],
    "RCT-Folly": [
      "2022.05.16.00"
    ],
    "glog": []
  },
  "pod_target_xcconfig": {
    "HEADER_SEARCH_PATHS": "\"$(PODS_ROOT)/boost\" \"$(PODS_ROOT)/Headers/Private/Yoga\"",
    "CLANG_CXX_LANGUAGE_STANDARD": "c++20"
  }
}
